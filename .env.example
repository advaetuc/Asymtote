# No secrets or public API base URL are required. All browser calls are same-origin.
# Optional LOCAL production integration build only; never set this on Vercel.
# AUGMENTR_LOCAL_API_PROXY=1
# Optional Playwright settings (build with the local proxy before production tests).
# E2E_PRODUCTION=1
# E2E_REUSE_SERVERS=0
# PLAYWRIGHT_BROWSERS_PATH=C:\path\to\browser-cache
