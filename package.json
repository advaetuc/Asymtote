{
  "name": "tulya",
  "version": "0.1.0",
  "private": true,
  "description": "Educational linear equation solver",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev",
    "dev:api": "uv run uvicorn api.index:app --reload --host 127.0.0.1 --port 18000",
    "dev:integrated": "vercel dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "uv run pytest",
    "lint:python": "uv run ruff check . && uv run ruff format --check .",
    "typecheck:python": "uv run mypy",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "katex": "0.18.9",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "plotly.js": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-plotly.js": "4.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
