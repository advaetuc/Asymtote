{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "excludeFiles": "{.tools/**,.venv/**,venv/**,node_modules/**,.next/**,.git/**,.github/**,.vercel/**,.env*,app/**,components/**,lib/**,public/**,tests/**,docs/**,scripts/**,playwright-report/**,test-results/**,**/__pycache__/**,.pytest_cache/**,.mypy_cache/**,.ruff_cache/**,.hypothesis/**}"
    }
  }
}
