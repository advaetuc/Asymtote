  "framework": "nextjs",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.tools/**,.venv/**,venv/**,tests/**,docs/**,playwright-report/**,test-results/**}"
    }
  }
}
